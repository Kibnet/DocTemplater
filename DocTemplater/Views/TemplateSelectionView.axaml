<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DocTemplater.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DocTemplater.Views.TemplateSelectionView"
             x:DataType="vm:TemplateSelectionViewModel">
    
    <Design.DataContext>
        <vm:TemplateSelectionViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        
        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Выбор шаблона документа" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Выберите шаблон для заполнения" 
                       FontSize="14" 
                       Foreground="#666"/>
        </StackPanel>

        <!-- Список шаблонов -->
        <Border Grid.Row="1" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="4"
                Padding="10">
            <Grid RowDefinitions="*,Auto">
                
                <!-- ListBox для шаблонов -->
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate}"
                         IsEnabled="{Binding !IsLoading}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" 
                                    Margin="0,2"
                                    Background="Transparent"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FilePath}" 
                                               FontSize="12" 
                                               Foreground="#666"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Сообщение о статусе -->
                <TextBlock Grid.Row="1" 
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Панель действий -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            
            <Button Content="Обновить" 
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Padding="20,10"/>
            
            <Button Content="Выбрать" 
                    Command="{Binding SelectTemplateCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Classes="accent"
                    Padding="30,10"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="0" 
                Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="White"
                    Padding="30,20">
                <StackPanel Spacing="10">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
