<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DocTemplater.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DocTemplater.Views.DataInputView"
             x:DataType="vm:DataInputViewModel">
    
    <Design.DataContext>
        <vm:DataInputViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        
        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding TemplateName, StringFormat='Заполнение шаблона: {0}'}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Заполните все поля и сохраните документ" 
                       FontSize="14" 
                       Foreground="#666"/>
        </StackPanel>

        <!-- Область прокрутки с полями ввода -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                
                <!-- Динамические поля для плейсхолдеров -->
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="4"
                                    Padding="15"
                                    Margin="0,0,0,10">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="150,*">
                                    
                                    <!-- Название плейсхолдера -->
                                    <TextBlock Grid.Row="0" 
                                               Grid.Column="0" 
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Label}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    
                                    <!-- Метка поля -->
                                    <TextBlock Grid.Row="1" 
                                               Grid.Column="0"
                                               Text="Значение:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    
                                    <!-- Поле ввода (TextBox для String и Integer) -->
                                    <TextBox Grid.Row="1" 
                                             Grid.Column="1"
                                             Text="{Binding ValueText, Mode=TwoWay}"
                                             Watermark="{Binding Placeholder}"
                                             IsVisible="{Binding !IsDateTimeType}"/>
                                    
                                    <!-- Поле ввода даты (DatePicker для DateTimeOffset) -->
                                    <DatePicker Grid.Row="1" 
                                                Grid.Column="1"
                                                SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                                IsVisible="{Binding IsDateTimeType}"/>
                                    
                                    <!-- Превью -->
                                    <TextBlock Grid.Row="2" 
                                               Grid.Column="0"
                                               Text="Превью:"
                                               VerticalAlignment="Top"
                                               Margin="0,8,10,0"/>
                                    
                                    <Border Grid.Row="2" 
                                            Grid.Column="1"
                                            Background="#F5F5F5"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Preview}" 
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    
                                    <!-- Ошибка валидации -->
                                    <TextBlock Grid.Row="3" 
                                               Grid.Column="1"
                                               Text="{Binding ValidationError}"
                                               Foreground="Red"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding !!ValidationError}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Настройки сохранения -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="15"
                        Background="#FAFAFA">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Настройки сохранения" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        
                        <!-- Путь к выходному файлу -->
                        <Grid ColumnDefinitions="120,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Выходной файл:"
                                       VerticalAlignment="Center"/>
                            
                            <TextBox Grid.Column="1"
                                     Text="{Binding OutputFilePath, Mode=TwoWay}"
                                     Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="2"
                                    Content="Обзор..."
                                    Command="{Binding BrowseOutputPathCommand}"
                                    Padding="15,8"/>
                        </Grid>
                        
                        <!-- Галочка "Открыть после сохранения" -->
                        <CheckBox IsChecked="{Binding OpenAfterSave}"
                                  Content="Открыть после сохранения"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Панель действий -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,20,0,0">
            
            <Button Grid.Column="0"
                    Content="← Назад" 
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding !IsSaving}"
                    Padding="20,10"/>
            
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
                
                <Button Content="Очистить" 
                        Command="{Binding ClearCommand}"
                        IsEnabled="{Binding !IsSaving}"
                        Padding="20,10"/>
                
                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsSaving}"
                        Classes="accent"
                        Padding="30,10"/>
            </StackPanel>
        </Grid>

        <!-- Индикатор сохранения -->
        <Border Grid.Row="0" 
                Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsSaving}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="White"
                    Padding="30,20">
                <StackPanel Spacing="10">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="Сохранение документа..." 
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
