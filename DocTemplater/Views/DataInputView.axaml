<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DocTemplater.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DocTemplater.Views.DataInputView"
             x:DataType="vm:DataInputViewModel">
    
    <Design.DataContext>
        <vm:DataInputViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        
        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding TemplateName, StringFormat='Заполнение шаблона: {0}'}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Измените значения и сохраните их или создайте документ."
                       FontSize="14"/>
        </StackPanel>

        <!-- Область прокрутки с полями ввода -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding !IsBusy}">
            <StackPanel Spacing="15">
                
                <!-- Динамические поля для плейсхолдеров -->
                <ItemsControl ItemsSource="{Binding Fields}" Name="FieldsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" 
                                    CornerRadius="4"
                                    Padding="5"
                                    Margin="0,0,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,*">
                                    
                                    <!-- Название плейсхолдера -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Label}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,0"/>
                                    
                                    <!-- Поле ввода (TextBox для String) -->
                                    <TextBox Grid.Row="1" Grid.Column="0"
                                             Text="{Binding ValueText, Mode=TwoWay}"
                                             Watermark="{Binding Label}"
                                             IsVisible="{Binding IsStringType}"
                                             MinWidth="180"
                                             Name="ValueTextBox"/>
                                    
                                    <!-- Поле ввода числа (NumericUpDown для Integer) -->
                                    <NumericUpDown Grid.Row="1" Grid.Column="0"
                                                   Value="{Binding IntegerValue, Mode=TwoWay}"
                                                   Watermark="Введите число"
                                                   IsVisible="{Binding IsIntegerType}"
                                                   Minimum="0"
                                                   Maximum="999999"
                                                   Increment="1"
                                                   FormatString="N0"
                                                   MinWidth="120"
                                                   Name="IntegerValueUpDown"/>
                                    
                                    <!-- Поле ввода даты (DatePicker для DateTimeOffset) -->
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                IsVisible="{Binding IsDateTimeType}"
                                                Name="DateQuickButtonsPanel">
                                        <DatePicker SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                                    Name="DateValuePicker"/>
                                        <Button Content="+1 день"
                                                Command="{Binding AddDayCommand}"
                                                Padding="8,4"
                                                Name="AddDayButton"/>
                                        <Button Content="+1 месяц"
                                                Command="{Binding AddMonthCommand}"
                                                Padding="8,4"
                                                Name="AddMonthButton"/>
                                        <Button Content="+1 год"
                                                Command="{Binding AddYearCommand}"
                                                Padding="8,4"
                                                Name="AddYearButton"/>
                                    </StackPanel>

                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="{Binding PlaceholderToken}"
                                            Command="{Binding InsertPlaceholderTokenCommand}"
                                            Padding="8,4"
                                            Margin="6,0"
                                            VerticalAlignment="Center"
                                            Name="InsertPlaceholderTokenButton"/>
                                    
                                    <!-- Превью -->
                                    
                                    <Border Grid.Row="1" 
                                            Grid.Column="2"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5"
                                            Margin="0,0,0,0">
                                        <TextBlock Text="{Binding Preview}" 
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    
                                    <!-- Ошибка валидации -->
                                    <TextBlock Grid.Row="2" 
                                               Grid.ColumnSpan="3"
                                               Text="{Binding ValidationError}"
                                               Foreground="Red"
                                               FontSize="12"
                                               Margin="0,0,0,0"
                                               IsVisible="{Binding !!ValidationError}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Панель действий -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
              Margin="0,12,0,0">
            
            <Button Grid.Row="1" Grid.Column="0"
                    HorizontalAlignment="Left"
                    Content="← Назад" 
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Padding="20,10"
                    Name="BackButton"/>
            
            <!-- Настройки сохранения в центре -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                        IsEnabled="{Binding !IsBusy}"
                        Name="SaveSettingsPanel"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,10"
                        Spacing="6">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Имя файла:"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Text="{Binding OutputFileNameTemplate, Mode=TwoWay}"
                             Grid.Column="1"
                             MinWidth="260"
                             Name="OutputFileNameTemplateTextBox"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Выходной файл:"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Text="{Binding OutputFilePath, Mode=TwoWay}"
                             Grid.Column="1"
                             MinWidth="260"
                             Name="OutputFilePathTextBox"/>
                    <Button Content="Обзор..."
                            Grid.Column="2"
                            Command="{Binding BrowseOutputPathCommand}"
                            Padding="15,8"
                            Margin="10,0,0,0"
                            Name="BrowseOutputPathButton"/>
                </Grid>
                <CheckBox IsChecked="{Binding OpenAfterSave}"
                          Content="Открыть после сохранения"
                          VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Grid.Row="1" Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                
                <Button Content="Очистить" 
                        Command="{Binding ClearCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="20,10"
                        Name="ClearButton"/>
                
                <Button Content="Сохранить значения"
                        Command="{Binding SaveValuesCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="16,10"
                        Name="SaveValuesButton"/>

                <Button Content="Сохранить документ"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="accent"
                        Padding="16,10"
                        Name="SaveButton"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" Margin="0,10,0,0"
                       Name="StatusMessageTextBlock"/>
        </Grid>

        <!-- Индикатор сохранения -->
        <Border Grid.Row="0" 
                Grid.RowSpan="3"
                IsVisible="{Binding IsBusy}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="30,20">
                <StackPanel Spacing="10">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
