<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DocTemplater.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DocTemplater.Views.DataInputView"
             x:DataType="vm:DataInputViewModel">
    
    <Design.DataContext>
        <vm:DataInputViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        
        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding TemplateName, StringFormat='Заполнение шаблона: {0}'}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Заполните все поля и сохраните документ" 
                       FontSize="14"/>
        </StackPanel>

        <!-- Область прокрутки с полями ввода -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                
                <!-- Динамические поля для плейсхолдеров -->
                <ItemsControl ItemsSource="{Binding Fields}" Name="FieldsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" 
                                    CornerRadius="4"
                                    Padding="15"
                                    Margin="0,0,0,10">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="150,*">
                                    
                                    <!-- Название плейсхолдера -->
                                    <TextBlock Grid.Row="0" 
                                               Grid.Column="0" 
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Label}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    
                                    <!-- Метка поля -->
                                    <TextBlock Grid.Row="1" 
                                               Grid.Column="0"
                                               Text="Значение:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    
                                    <!-- Поле ввода (TextBox для String) -->
                                    <TextBox Grid.Row="1" 
                                             Grid.Column="1"
                                             Text="{Binding ValueText, Mode=TwoWay}"
                                             Watermark="{Binding Placeholder}"
                                             IsVisible="{Binding IsStringType}"
                                             Name="ValueTextBox"/>
                                    
                                    <!-- Поле ввода числа (NumericUpDown для Integer) -->
                                    <NumericUpDown Grid.Row="1" 
                                                   Grid.Column="1"
                                                   Value="{Binding IntegerValue, Mode=TwoWay}"
                                                   Watermark="Введите число"
                                                   IsVisible="{Binding IsIntegerType}"
                                                   Minimum="0"
                                                   Maximum="999999"
                                                   Increment="1"
                                                   FormatString="N0"
                                                   Name="IntegerValueUpDown"/>
                                    
                                    <!-- Поле ввода даты (DatePicker для DateTimeOffset) -->
                                    <DatePicker Grid.Row="1" 
                                                Grid.Column="1"
                                                SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                                IsVisible="{Binding IsDateTimeType}"
                                                Name="DateValuePicker"/>
                                    
                                    <!-- Превью -->
                                    <TextBlock Grid.Row="2" 
                                               Grid.Column="0"
                                               Text="Превью:"
                                               VerticalAlignment="Top"
                                               Margin="0,8,10,0"/>
                                    
                                    <Border Grid.Row="2" 
                                            Grid.Column="1"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Preview}" 
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    
                                    <!-- Ошибка валидации -->
                                    <TextBlock Grid.Row="3" 
                                               Grid.Column="1"
                                               Text="{Binding ValidationError}"
                                               Foreground="Red"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding !!ValidationError}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Панель действий -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,20,0,0">
            
            <Button Grid.Column="0"
                    Content="← Назад" 
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding !IsSaving}"
                    Padding="20,10"
                    Name="BackButton"/>
            
            <!-- Настройки сохранения в центре -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="Выходной файл:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox Text="{Binding OutputFilePath, Mode=TwoWay}"
                         Width="300"
                         Name="OutputFilePathTextBox"/>
                <Button Content="Обзор..."
                        Command="{Binding BrowseOutputPathCommand}"
                        Padding="15,8"/>
                <CheckBox IsChecked="{Binding OpenAfterSave}"
                          Content="Открыть после сохранения"
                          VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">
                
                <Button Content="Очистить" 
                        Command="{Binding ClearCommand}"
                        IsEnabled="{Binding !IsSaving}"
                        Padding="20,10"
                        Name="ClearButton"/>
                
                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsSaving}"
                        Classes="accent"
                        Padding="30,10"
                        Name="SaveButton"/>
            </StackPanel>
        </Grid>

        <!-- Индикатор сохранения -->
        <Border Grid.Row="0" 
                Grid.RowSpan="3"
                IsVisible="{Binding IsSaving}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="30,20">
                <StackPanel Spacing="10">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="Сохранение документа..." 
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
